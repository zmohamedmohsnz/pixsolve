# General
NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=http://localhost:3000

# Database
DB_URI=mongodb://127.0.0.1:27017/pixsolve

# Logging
LOG_LEVEL=info

# Background Processing
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (Resend Service)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=auth@your-verified-domain.example

# Authentication
EMAIL_VERIFICATION_TOKEN_LIFETIME_MINS=1440
JWT_ACCESS_TOKEN_SECRET=replace-with-a-secure-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_LIFETIME_MINS=15