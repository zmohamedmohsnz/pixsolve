# Runtime
NODE_ENV=<development|test|production>
PORT=<api-port>
LOG_LEVEL=<trace|debug|info|warn|error|fatal>

# Public browser URLs
PUBLIC_APP_URL=https://<frontend-domain>
ALLOWED_ORIGINS=https://<frontend-domain>

# MongoDB Atlas
DB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://<redis-host>:<redis-port>

# Cloudinary -- server-side only
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Resend -- the sender domain must be verified in Resend
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=auth@<verified-sender-domain>

# Authentication
EMAIL_VERIFICATION_TOKEN_LIFETIME_MINS=<positive-integer-minutes>
JWT_ACCESS_TOKEN_SECRET=<high-entropy-secret-at-least-32-characters>
JWT_ACCESS_TOKEN_LIFETIME_MINS=<positive-integer-minutes>
PASSWORD_RESET_TOKEN_LIFETIME_MINS=<positive-integer-minutes>

# Authentication rate limiting
AUTH_RATE_LIMIT_WINDOW_MINS=<positive-integer-minutes>
AUTH_RATE_LIMIT_MAX_REQUESTS=<positive-integer>
